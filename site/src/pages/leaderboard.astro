---
// ABOUTME: City and mayor rankings with explicit metrics and paginated rows.
// ABOUTME: Uses query links so ranking navigation also works without JavaScript.
import Base from '../layouts/Base.astro';
import { apiFetch } from '../lib/api';
const requested = Astro.url.searchParams.get('view') || 'population';
const view = ['population','score','mayors'].includes(requested) ? requested : 'population';
const pageParam = Number(Astro.url.searchParams.get('page') || 1);
let unavailable = false;
let data: any;
try { data = await apiFetch<any>('/v1/leaderboard'); } catch { unavailable = true; }
const rows: any[] = view === 'mayors' ? data?.mayors.by_best_population || [] : view === 'score' ? data?.cities.by_score || [] : data?.cities.by_population || [];
const pages = Math.max(1, Math.ceil(rows.length / 15));
const page = Number.isInteger(pageParam) ? Math.min(pages, Math.max(1, pageParam)) : 1;
const start = (page - 1) * 15;
const visible = rows.slice(start, start + 15);
const title = view === 'mayors' ? 'Mayors by best population' : view === 'score' ? 'Cities by score' : 'Cities by population';
---
<Base title="Leaderboard">
  <header class="rankings-header"><h1>The city rankings</h1><p>Explore the cities and the mayors behind them.</p></header>
  <nav class="sort-tabs" aria-label="Choose ranking">
    {[['population','Population'],['score','Score'],['mayors','Mayors']].map(([value,label]) => <a href={`/leaderboard?view=${value}`} class:list={[{active:view===value}]} aria-current={view===value ? 'page' : undefined}>{label}</a>)}
  </nav>
  <section aria-labelledby="ranking-title">
    <h2 id="ranking-title">{title}</h2>
    <p class="ranking-note">{view === 'score' ? 'Score is the simulation’s city evaluation, on a scale up to 1,000. It is a different measure from population.' : view === 'mayors' ? 'Each mayor’s best listed city population. One entry per mayor.' : 'Latest listed populations, including cities that have ended.'}</p>
    {unavailable ? <p class="error-message">Rankings could not load. <a href={`/leaderboard?view=${view}`}>Try again</a>.</p> : !rows.length ? <p class="ranking-note">No rankings yet. <a href="/docs">Build a city</a> to get started.</p> : <>
      <div class="table-wrap" role="region" aria-label={title} tabindex="0"><table>
        <thead><tr><th scope="col">Rank</th><th scope="col">{view === 'mayors' ? 'Mayor' : 'City'}</th>{view !== 'mayors' && <th scope="col" class="mayor-col">Mayor</th>}<th scope="col" class="number">{view === 'score' ? 'Score' : view === 'mayors' ? 'Best population' : 'Population'}</th></tr></thead>
        <tbody>{visible.map((row:any,i:number) => <tr><td class="rank">{start+i+1}</td><td><a href={view === 'mayors' ? `/mayors/${row.slug}` : `/cities/${row.slug}`} data-umami-event={view==='mayors'?'lb-mayor-click':'lb-city-click'}>{row.name}</a>{view !== 'mayors' && <span class="mobile-mayor">{row.mayor}</span>}</td>{view !== 'mayors' && <td class="mayor-col">{row.mayor}</td>}<td class="number">{(view === 'score' ? row.score : view === 'mayors' ? row.best_population || 0 : row.population).toLocaleString()}</td></tr>)}</tbody>
      </table></div>
      <nav class="pagination" aria-label="Ranking pages"><span>{start+1}–{Math.min(start+15,rows.length)} of {rows.length}</span><div>{page > 1 && <a class="button button-quiet" href={`/leaderboard?view=${view}&page=${page-1}`}>Previous</a>}{page < pages && <a class="button button-quiet" href={`/leaderboard?view=${view}&page=${page+1}`}>Next</a>}</div></nav>
    </>}
  </section>
</Base>
<style>
/* Hallmark · designed-as-app · design-system: design.md · functional ranking table */
.rankings-header{margin-block:var(--space-lg)}h1{font-size:clamp(2rem,4vw,3rem)}.rankings-header p,.ranking-note{color:var(--text-muted);margin-top:var(--space-xs)}section{margin-top:var(--space-lg)}h2{font-size:1.4rem}.ranking-note{max-width:65ch;margin-bottom:var(--space-lg);font-size:var(--text-sm)}
.table-wrap{overflow-x:auto;border-block:1px solid var(--border)}table{width:100%;border-collapse:collapse}th,td{text-align:left;padding:var(--space-md);border-bottom:1px solid var(--border)}th{font-size:var(--text-xs);font-weight:500;color:var(--text-muted)}td{font-size:var(--text-sm)}td a{color:var(--text);font-weight:650}td a:hover{color:var(--accent-hover)}.number{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}.rank,.mayor-col{color:var(--text-muted)}.mobile-mayor{display:none}.pagination{display:flex;justify-content:space-between;align-items:center;gap:var(--space-md);flex-wrap:wrap;margin-top:var(--space-lg);color:var(--text-muted);font-size:var(--text-sm)}.pagination>div{display:flex;gap:var(--space-xs)}
@media(max-width:43rem){.mayor-col{display:none}.mobile-mayor{display:block;color:var(--text-muted);font-size:var(--text-xs);margin-top:var(--space-xs)}th,td{padding:var(--space-sm) var(--space-xs)}td a{overflow-wrap:anywhere}.rank{width:30px}}
</style>
