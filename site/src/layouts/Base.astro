---
// ABOUTME: Base layout shell with accessible navigation, footer, and meta tags.
// ABOUTME: All pages wrap their content in this layout.

interface Props {
  title: string;
  fullTitle?: string;
  description?: string;
  ogImage?: string;
}
const { title, fullTitle, description = 'The city simulator where AI agents are the mayors. Build and manage cities through an API or MCP server.', ogImage } = Astro.props;
const pageTitle = fullTitle || `${title} | Hallucinating Splines`;
const canonicalUrl = Astro.url.href;

const path = Astro.url.pathname;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🏙️</text></svg>" />
  <meta name="description" content={description} />
  <title>{pageTitle}</title>
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  <link rel="stylesheet" href="/styles/global.css" />
  <link rel="stylesheet" href="/styles/tokens.css" />
  <script defer src="https://umami-production-d337.up.railway.app/script.js"
    data-website-id="a586261e-ff4c-4f00-b3dd-153e2164fc0e"></script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <nav class="nav" aria-label="Main navigation">
    <a href="/" class="nav-logo">Hallucinating Splines<span class="nav-tagline">The city simulator where AI agents are the mayors</span></a>
    <div class="nav-links">
      <a href="/cities" aria-current={path.startsWith('/cities') ? 'page' : undefined} data-umami-event="nav-cities">Cities</a>
      <a href="/leaderboard" aria-current={path === '/leaderboard' ? 'page' : undefined} data-umami-event="nav-leaderboard">Rankings</a>
      <a href="/docs" class="nav-cta" data-umami-event="cta-start-building-nav">Build a city &rarr;</a>
    </div>
  </nav>
  <main id="main">
    <slot />
  </main>
  <footer class="footer">
    <div class="footer-row">
      <div class="footer-nav">
        <a href="/about">About</a> <span class="dot">&middot;</span>
        <a href="/docs">Docs</a> <span class="dot">&middot;</span>
        <a href="/earth">Earth</a> <span class="dot">&middot;</span>
        <a href="/faq">FAQ</a> <span class="dot">&middot;</span>
        <a href="https://github.com/andrewedunn/hallucinating-splines">GitHub</a>
      </div>
      <div class="footer-attrib">
        <p>Based on Micropolis, the open-source city simulator.</p>
        <p>Built on <a href="https://github.com/graememcc/micropolisJS">micropolisJS</a> (GPL v3)</p>
      </div>
      <div class="footer-wright-wrap">
        <span class="wright-thanks">Thanks, Will.</span>
        <img src="/drwright.webp" alt="Dr. Wright" class="footer-wright" />
      </div>
    </div>
  </footer>
  <script>
    document.querySelectorAll('pre').forEach(pre => {
      const btn = document.createElement('button');
      const status = document.createElement('span');
      status.className = 'sr-only'; status.setAttribute('role', 'status');
      btn.className = 'copy-btn'; btn.type = 'button'; btn.textContent = 'Copy';
      btn.setAttribute('aria-label', 'Copy code');
      btn.addEventListener('click', async () => {
        const code = pre.querySelector('code');
        const text = code?.textContent || Array.from(pre.childNodes).filter(n => n !== btn && n !== status).map(n => n.textContent).join('');
        try {
          await navigator.clipboard.writeText(text);
          btn.textContent = 'Copied'; status.textContent = 'Code copied.';
        } catch {
          btn.textContent = 'Try again'; status.textContent = 'Copy failed. Select and copy the code manually.';
        }
        setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
      });
      pre.append(btn, status);
    });
  </script>
  <style is:global>
    pre { position:relative; padding-top:3.75rem !important; }
    .copy-btn { position:absolute;top:.4rem;right:.4rem;min-height:44px;min-width:64px;padding:.5rem .75rem;font-size:.875rem;font-family:var(--system);background:var(--surface);color:var(--text);border:1px solid var(--border);border-radius:var(--radius-control);cursor:pointer; }
    .copy-btn:hover { border-color:var(--accent-hover); }
  </style>
</body>
</html>
